{
  "rules": {
    "users": {
      ".read": true,
      "$safeEmail": {
        ".read": true,
        ".write": true
      }
    },
    "userData": {
      "$userId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["userId", "syncedAt"]
      }
    },
    "deletedWorkers": {
      ".read": true,
      "$safeEmail": {
        ".read": true,
        ".write": true
      }
    }
  }
}
